<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RefreshToggle</AssemblyName>
    <RootNamespace>RefreshToggle.App</RootNamespace>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RefreshToggle.Application\RefreshToggle.Application.csproj" />
    <ProjectReference Include="..\RefreshToggle.Core\RefreshToggle.Core.csproj" />
    <ProjectReference Include="..\RefreshToggle.Windows\RefreshToggle.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\icon.ico" Link="icon.ico" LogicalName="RefreshToggle.icon.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(DistributionBuild)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RefreshToggle.DistributionBuild</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RefreshToggle.RuntimeIdentifier</_Parameter1>
      <_Parameter2>$(RuntimeIdentifier)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RefreshToggle.SelfContained</_Parameter1>
      <_Parameter2>$(SelfContained)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RefreshToggle.SingleFile</_Parameter1>
      <_Parameter2>$(PublishSingleFile)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="RemoveDistributionDocumentationSidecars"
          AfterTargets="Publish"
          Condition="'$(DistributionBuild)' == 'true'">
    <ItemGroup>
      <_DistributionDocumentationSidecar Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(_DistributionDocumentationSidecar)" />
  </Target>

</Project>
